#!/usr/bin/env bash
set -euo pipefail

# jimeng-cli-free 的 CLI 版本（独立于内部 opencli runtime 版本）
CLI_VERSION="1.0.0"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"

usage() {
  cat <<'EOF'
jimeng-cli-free — 驱动即梦（Jimeng / Dreamina）网页端生图的本机命令行工具

用法:
  bash bin/jimeng-cli-free <命令> [参数]

命令:
  ensure                安装/检测运行环境与浏览器插件，并验证即梦登录状态
  generate <提示词>     文生图 / 参考图生图（默认）
  edit <图片> <提示词>  基于本地图片的图片编辑
  runtime-version       打印内部 opencli runtime 版本（需 runtime 已构建）
  version               打印 jimeng-cli-free CLI 版本（+ runtime 版本，若就绪）
  help                  显示本帮助（也可用 -h / --help）

generate 用法:
  bash bin/jimeng-cli-free generate "<提示词>" [选项]
  注意: <提示词> 必须是 generate 之后第一个非 -- 的参数。

  选项:
    --model <模型>        模型，见下方取值表；默认 high_aes_general_v47
                          传 free 切到 config.json 的 default_free_model（会员免费模型）
    --aspect <比例>       比例，见下方取值表；默认 9:16
    --format <格式>       输出格式 png / jpg / webp；默认 png
    --output <目录>       结果输出根目录；默认 <仓库>/output/。
                          传入则把本次结果落到 <目录>/<时间戳>/，
                          便于「在当前工作目录直接拿到图」。
    --workspace <id>      指定即梦对话 workspace；默认按任务复用（见环境变量）
    --generate-count <n>  生成数量，必须是 >0 的整数；默认 1
    --mode <模式>         text / reference / edit；默认 text
    --reference <路径|URL|clipboard>
                          参考图：本地文件路径 / 图片 URL / 关键字 clipboard
    --reference-url <URL> 显式指定参考图 URL
    --clipboard           直接使用系统剪贴板里的图片作为参考图

edit 用法:
  bash bin/jimeng-cli-free edit "<图片路径>" "<提示词>" [选项]
  支持上述 generate 的 --model / --aspect / --format / --output / --workspace 等选项。

模型取值 (--model):
  high_aes_general_v47   图片 4.7（默认）
  high_aes_general_v50   图片 5.0 Lite
  high_aes_general_v42   图片 4.6
  high_aes_general_v45   图片 4.5
  high_aes_general_v41   图片 4.1
  high_aes_general_v40   图片 4.0
  free                   别名：切换到 config.json 的 default_free_model
  <中文标签>             也支持直接传即梦下拉里的中文标签，例如「图片3.0」

比例取值 (--aspect):
  smart | 21:9 | 16:9 | 3:2 | 4:3 | 1:1 | 3:4 | 2:3 | 9:16     （默认 9:16）

输出约定:
  - 每次生成创建 <输出根>/<时间戳>/ 目录，内含:
      0001.<format>        生成结果图（默认 0001.png，单张）
      prompt.txt           本次提示词
      result.json          runtime 返回的原始结果
      result.stderr.log    运行时诊断日志
  - 成功时，stdout 只输出该目录的绝对路径，便于脚本捕获。
  - 进度与日志一律走 stderr，不污染 stdout。

退出码:
  0    成功
  1    参数错误 / 缺少必填项
  2    生成失败（已重试 max_generate_attempts 次仍失败）
  75   浏览器会话锁等待超时（另一个即梦任务正在占用浏览器）

环境变量:
  JIMENG_CLI_DIR     jimeng-cli-free 仓库根目录；外部 agent 用它定位本 CLI
  JIMENG_TASK_KEY    任务标识；相同 key 会复用同一个即梦对话
                     （默认 per_task 复用，避免「每张图一个对话」导致账号对话数爆炸）
  JIMENG_OPENCLI_LOCK_TIMEOUT_SECONDS
                     浏览器会话锁等待上限（默认 360 秒）

示例:
  # 文生图，结果落到默认 <仓库>/output/
  bash bin/jimeng-cli-free generate "海边玻璃建筑，青绿色植物" --model high_aes_general_v47 --aspect 16:9

  # 把结果直接落到当前工作目录
  bash bin/jimeng-cli-free generate "极简产品海报" --aspect 16:9 --output "$(pwd)"

  # 参考图生图：本地文件 / URL / 剪贴板
  bash bin/jimeng-cli-free generate "改成电影海报风格" --reference ./ref.png --mode reference
  bash bin/jimeng-cli-free generate "改成电影海报风格" --reference https://example.com/ref.png --mode reference
  bash bin/jimeng-cli-free generate "改成电影海报风格" --clipboard --mode reference

  # 图片编辑
  bash bin/jimeng-cli-free edit ./input.png "把主体改成水彩插画风格" --aspect 16:9

  # 环境自检（首次使用或出错时先跑这个）
  bash bin/jimeng-cli-free ensure

完整文档与安装: https://github.com/zhangferry/jimeng-cli-free
EOF
}

print_version() {
  printf 'jimeng-cli-free %s\n' "$CLI_VERSION"
  # 复用 common.sh 的 skill_opencli_version（直接读 vendor package.json，不要求 runtime 完全就绪）
  # shellcheck source=../scripts/common.sh
  source "$SCRIPTS_DIR/common.sh"
  local rt_ver
  rt_ver="$(skill_opencli_version)"
  if [[ -n "$rt_ver" ]]; then
    printf 'opencli runtime: %s\n' "$rt_ver"
  else
    printf 'opencli runtime: (尚未构建，请先运行 ensure)\n'
  fi
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

cmd="$1"
shift

case "$cmd" in
  ensure)
    exec bash "$SCRIPTS_DIR/ensure_opencli_and_jimeng.sh"
    ;;
  runtime-version)
    exec bash "$SCRIPTS_DIR/run_opencli.sh" --version
    ;;
  version|--version|-V)
    print_version
    ;;
  generate)
    if [[ $# -gt 0 && "${1:0:2}" != "--" ]]; then
      prompt="$1"
      shift
      exec bash "$SCRIPTS_DIR/generate_image.sh" --prompt "$prompt" "$@"
    fi
    exec bash "$SCRIPTS_DIR/generate_image.sh" "$@"
    ;;
  edit)
    if [[ $# -ge 2 && "${1:0:2}" != "--" && "${2:0:2}" != "--" ]]; then
      image="$1"
      prompt="$2"
      shift 2
      exec bash "$SCRIPTS_DIR/edit_image.sh" --image "$image" --prompt "$prompt" "$@"
    fi
    exec bash "$SCRIPTS_DIR/edit_image.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "未知命令：${cmd}（用 help 查看可用命令）" >&2
    usage >&2
    exit 1
    ;;
esac
